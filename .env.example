# --- Source website (EdgeProp) ---
# Base listing pages to scrape (support multiple URLs separated by pipes "|")
SOURCE_BASE_URL=https://www.edgeprop.sg/new-launches/all-new-property-launches
SOURCE_MAX_PAGES=20

# --- Scrape schedule (cron syntax). Default: once daily at 3am ---
CRON_SCHEDULE=0 3 * * *

# --- Wix Data/CMS ---
# Set to true to sync scraped listings to Wix, or false to only save locally in data/listings.json
WIX_SYNC_ENABLED=false
# API key from Wix Developers Center -> Headless Settings -> API Keys
WIX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Found in your Wix site dashboard URL or Site -> Settings -> General
WIX_SITE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Data Collection ID created in Wix CMS (Content Manager) to store properties
WIX_DATA_COLLECTION_ID=Properties
# Optional: required only for some account-level endpoints
WIX_ACCOUNT_ID=

# --- Request behavior ---
REQUEST_TIMEOUT_MS=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# --- Logging ---
LOG_LEVEL=info
